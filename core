<script>
(function(){
  let state = null;
  let saving = false;
  let pendingActionType = null;
  let dbRef = null;
  let firebaseReady = false;

  function initFirebase(){
    if(!firebaseConfig.apiKey || firebaseConfig.apiKey === 'YOUR_API_KEY'){
      document.getElementById('gacha-root').innerHTML =
        '<div style="max-width:480px;margin:60px auto;padding:24px;background:#20202f;border:1px solid #33334a;border-radius:16px;color:#f1f0f6;font-family:sans-serif;line-height:1.6;">' +
        '<h2 style="margin-top:0;">Almost there</h2>' +
        '<p>This copy still has placeholder Firebase config. Paste your project\'s config into the <code>firebaseConfig</code> block near the top of this file, then reload the page.</p>' +
        '</div>';
      return false;
    }
    try{
      firebase.initializeApp(firebaseConfig);
      dbRef = firebase.database().ref('gacha-state');
      firebaseReady = true;
      return true;
    }catch(e){
      showToast('Firebase failed to initialize — check your config');
      return false;
    }
  }

  // ---- home screen / PWA setup (iOS Safari "Add to Home Screen") ----
  function setupHomeScreen(){
    const head = document.head;

    function ensureMeta(name, content){
      let el = head.querySelector(`meta[name="${name}"]`);
      if(!el){ el = document.createElement('meta'); el.setAttribute('name', name); head.appendChild(el); }
      el.setAttribute('content', content);
    }

    // required for env(safe-area-inset-*) to actually report non-zero values
    let viewport = head.querySelector('meta[name="viewport"]');
    if(!viewport){ viewport = document.createElement('meta'); viewport.setAttribute('name','viewport'); head.appendChild(viewport); }
    viewport.setAttribute('content', 'width=device-width, initial-scale=1, viewport-fit=cover');

    ensureMeta('apple-mobile-web-app-capable', 'yes');
    ensureMeta('apple-mobile-web-app-status-bar-style', 'black-translucent');
    ensureMeta('apple-mobile-web-app-title', 'Token Gacha');
    ensureMeta('theme-color', '#14141f');
    ensureMeta('mobile-web-app-capable', 'yes');

    document.title = 'Token Gacha';

    // generate a simple app icon (dark tile, gradient orb, gold star) for the home screen
    try{
      const size = 180;
      const canvas = document.createElement('canvas');
      canvas.width = size; canvas.height = size;
      const ctx = canvas.getContext('2d');

      ctx.fillStyle = '#14141f';
      ctx.fillRect(0,0,size,size);

      const grad = ctx.createRadialGradient(size*0.35,size*0.32,size*0.05, size*0.5,size*0.5,size*0.6);
      grad.addColorStop(0, 'rgba(255,79,163,0.9)');
      grad.addColorStop(0.55, 'rgba(139,124,246,0.55)');
      grad.addColorStop(1, 'rgba(79,216,255,0.0)');
      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.arc(size/2, size/2, size*0.46, 0, Math.PI*2);
      ctx.fill();

      // 4-point sparkle/star
      ctx.fillStyle = '#ffc857';
      ctx.beginPath();
      const cx = size/2, cy = size/2, r1 = size*0.16, r2 = size*0.045;
      for(let i=0;i<4;i++){
        const a0 = (Math.PI/2)*i;
        const aMid = a0 + Math.PI/4;
        ctx.lineTo(cx + Math.cos(a0)*r1, cy + Math.sin(a0)*r1);
        ctx.lineTo(cx + Math.cos(aMid)*r2, cy + Math.sin(aMid)*r2);
      }
      ctx.closePath();
      ctx.fill();

      const iconUrl = canvas.toDataURL('image/png');
      ['apple-touch-icon','icon','shortcut icon'].forEach(rel=>{
        let link = head.querySelector(`link[rel="${rel}"]`);
        if(!link){ link = document.createElement('link'); link.setAttribute('rel', rel); head.appendChild(link); }
        link.setAttribute('href', iconUrl);
      });

      // lightweight manifest for Android/Chrome parity (harmless on iOS)
      const manifest = {
        name: 'Token Gacha', short_name: 'Gacha', display: 'standalone',
        background_color: '#14141f', theme_color: '#14141f',
        icons: [{ src: iconUrl, sizes: '180x180', type: 'image/png' }]
      };
      const blob = new Blob([JSON.stringify(manifest)], { type: 'application/json' });
      const manifestUrl = URL.createObjectURL(blob);
      let manifestLink = head.querySelector('link[rel="manifest"]');
      if(!manifestLink){ manifestLink = document.createElement('link'); manifestLink.setAttribute('rel','manifest'); head.appendChild(manifestLink); }
      manifestLink.setAttribute('href', manifestUrl);
    }catch(e){ /* icon generation is best-effort; app still works without it */ }
  }
  setupHomeScreen();

  const defaultState = {
    pointValues: { pomodoro:1, lab:2, email:2, wakeup:1, streakEvery:4, streakBonus:1 },
    tiers: [
      { id:'common', name:'Next Level', cost:2, items:['Pick a snack', '5 extra min of break', 'Choose the next work playlist'] },
      { id:'rare', name:'Savage', cost:5, items:['Boba or coffee run', 'A cheap trinket / sticker haul', 'Skip one dreaded task, guilt-free'] },
      { id:'epic', name:'Armageddon', cost:10, items:['Photocard or small merch item', 'A proper meal out', 'A lazy morning, no alarm'] },
      { id:'legendary', name:'Supernova', cost:20, items:['Bigger aespa merch piece', 'Concert-adjacent purchase', 'A real splurge dinner'] }
    ],
    log: [],
    pulls: [],
    totalPoints: 0
  };

  function loadState(){
    // one-time initial read, so the UI has something to show immediately
    dbRef.once('value')
      .then(snap=>{
        state = snap.val() || structuredClone(defaultState);
        render();
      })
      .catch(()=>{
        state = structuredClone(defaultState);
        render();
      });

    // live listener: picks up changes made from the other person's device automatically
    dbRef.on('value', snap=>{
      const incoming = snap.val();
      if(incoming){
        state = incoming;
        render();
      }
    });
  }

  async function saveState(){
    if(saving || !firebaseReady) return;
    saving = true;
    try{
      await dbRef.set(state);
    }catch(e){
      showToast('Could not save — check connection');
    }
    saving = false;
  }

  function showToast(msg){
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(()=> t.classList.remove('show'), 1800);
  }

  function timeAgo(ts){
    const s = Math.floor((Date.now()-ts)/1000);
    if(s<60) return 'just now';
    const m = Math.floor(s/60);
    if(m<60) return m+'m ago';
    const h = Math.floor(m/60);
    if(h<24) return h+'h ago';
    const d = Math.floor(h/24);
    return d+'d ago';
  }

  function isSameDay(a,b){
    const da = new Date(a), db = new Date(b);
    return da.getFullYear()===db.getFullYear() && da.getMonth()===db.getMonth() && da.getDate()===db.getDate();
  }

  // ---- photo compression ----
  function compressImage(file){
    return new Promise((resolve, reject)=>{
      const reader = new FileReader();
      reader.onload = (e)=>{
        const img = new Image();
        img.onload = ()=>{
          const maxDim = 640;
          let w = img.width, h = img.height;
          if(w > h && w > maxDim){ h = Math.round(h * (maxDim/w)); w = maxDim; }
          else if(h > maxDim){ w = Math.round(w * (maxDim/h)); h = maxDim; }
          const canvas = document.createElement('canvas');
          canvas.width = w; canvas.height = h;
          canvas.getContext('2d').drawImage(img, 0, 0, w, h);
          resolve(canvas.toDataURL('image/jpeg', 0.6));
        };
        img.onerror = reject;
        img.src = e.target.result;
      };
      reader.onerror = reject;
      reader.readAsDataURL(file);
    });
  }

  const ACTIONS = [
    { type:'pomodoro', label:'Pomodoro done', key:'pomodoro' },
    { type:'lab', label:'Went to lab', key:'lab' },
    { type:'email', label:'Sent the email', key:'email' },
    { type:'wakeup', label:'Woke up on time', key:'wakeup' }
  ];

  function startLog(actionType){
    pendingActionType = actionType;
    document.getElementById('photoInput').click();
  }

  async function handlePhotoSelected(file){
    if(!file || !pendingActionType) return;
    const action = ACTIONS.find(a=>a.type===pendingActionType);
    let photo;
    try{
      photo = await compressImage(file);
    }catch(e){
      showToast('Could not read that photo — try again');
      pendingActionType = null;
      return;
    }
    const entry = {
      id: Date.now()+'-'+Math.random().toString(36).slice(2,7),
      type: action.type,
      label: action.label,
      points: state.pointValues[action.key],
      photo,
      status: 'pending',
      ts: Date.now()
    };
    state.log.unshift(entry);
    pendingActionType = null;
    saveState();
    render();
    showToast('Queued for review');
  }

  function todayApprovedPomodoroCount(){
    return state.log.filter(l => l.type==='pomodoro' && l.status==='approved' && isSameDay(l.ts, Date.now())).length;
  }

  function approveEntry(id){
    const entry = state.log.find(l=>l.id===id);
    if(!entry || entry.status!=='pending') return;
    entry.status = 'approved';
    entry.reviewedTs = Date.now();
    state.totalPoints += entry.points;

    if(entry.type === 'pomodoro'){
      const count = todayApprovedPomodoroCount();
      if(count>0 && count % state.pointValues.streakEvery === 0){
        const bonus = state.pointValues.streakBonus;
        state.totalPoints += bonus;
        state.log.unshift({
          id: Date.now()+'-bonus', type:'streak', label:`Streak bonus (${count} pomodoros today)`,
          points: bonus, status:'approved', ts: Date.now()+1, reviewedTs: Date.now()+1
        });
        showToast(`Approved — +${bonus} streak bonus too!`);
      } else {
        showToast('Approved');
      }
    } else {
      showToast('Approved');
    }
    saveState();
    render();
  }

  function rejectEntry(id){
    const entry = state.log.find(l=>l.id===id);
    if(!entry || entry.status!=='pending') return;
    entry.status = 'rejected';
    entry.reviewedTs = Date.now();
    saveState();
    render();
  }

  function attemptPull(tier){
    if(state.totalPoints < tier.cost){
      showToast(`Need ${tier.cost - state.totalPoints} more token(s)`);
      return;
    }
    state.totalPoints -= tier.cost;
    const item = tier.items[Math.floor(Math.random()*tier.items.length)];
    const pull = { id: Date.now()+'-pull', tier: tier.name, item, ts: Date.now() };
    state.pulls.unshift(pull);
    state.log.unshift({ id: pull.id+'-log', type:'pull', label:`Pulled ${tier.name}: ${item}`, points: -tier.cost, status:'approved', ts: pull.ts });
    saveState();
    render();
    playReveal(tier.name, item);
  }

  function playReveal(tierName, item){
    const stage = document.getElementById('revealStage');
    const inner = document.getElementById('revealInner');
    document.getElementById('revealTierTag').textContent = tierName;
    document.getElementById('revealItemName').textContent = item;
    stage.style.display = 'flex';
    inner.classList.remove('flipped');
    void inner.offsetWidth; // reflow to restart animation
    setTimeout(()=> inner.classList.add('flipped'), 120);
  }

  function render(){
    document.getElementById('pointsDisplay').textContent = state.totalPoints;

    const streakBadge = document.getElementById('streakBadge');
    const todayCount = todayApprovedPomodoroCount();
    if(todayCount > 0){
      streakBadge.style.display = 'inline-flex';
      streakBadge.textContent = `${todayCount} approved pomodoro${todayCount===1?'':'s'} today`;
    } else {
      streakBadge.style.display = 'none';
    }

    // log grid
    const logGrid = document.getElementById('logGrid');
    logGrid.innerHTML = '';
    ACTIONS.forEach(a=>{
      const btn = document.createElement('button');
      btn.className = 'log-btn';
      btn.innerHTML = `<span>${a.label}</span><span class="pts">+${state.pointValues[a.key]} (pending review)</span>`;
      btn.onclick = ()=> startLog(a.type);
      logGrid.appendChild(btn);
    });

    // pending queue
    const pending = state.log.filter(l=>l.status==='pending');
    const pendingCountEl = document.getElementById('pendingCount');
    if(pending.length>0){
      pendingCountEl.style.display = 'inline-block';
      pendingCountEl.textContent = pending.length;
    } else {
      pendingCountEl.style.display = 'none';
    }
    const pendingList = document.getElementById('pendingList');
    pendingList.innerHTML = '';
    if(pending.length===0){
      pendingList.innerHTML = '<div class="pending-empty">Nothing waiting on you right now.</div>';
    } else {
      pending.forEach(entry=>{
        const row = document.createElement('div');
        row.className = 'pending-row';
        row.innerHTML = `
          <img class="pending-thumb" src="${entry.photo}" alt="">
          <div class="pending-info">
            <div class="label">${entry.label}</div>
            <div class="meta">+${entry.points} · ${timeAgo(entry.ts)}</div>
          </div>
          <div class="pending-actions">
            <button class="approve-btn">Approve</button>
            <button class="reject-btn">Reject</button>
          </div>
        `;
        row.querySelector('.approve-btn').onclick = ()=> approveEntry(entry.id);
        row.querySelector('.reject-btn').onclick = ()=> rejectEntry(entry.id);
        pendingList.appendChild(row);
      });
    }

    // tiers
    const tierGrid = document.getElementById('tierGrid');
    tierGrid.innerHTML = '';
    state.tiers.forEach(tier=>{
      const card = document.createElement('button');
      const affordable = state.totalPoints >= tier.cost;
      card.className = `tier-card tier-${tier.id}` + (affordable ? '' : ' disabled');
      card.innerHTML = `<div class="glow"></div><div class="name">${tier.name}</div><div class="cost">${tier.cost} tokens</div>`;
      card.onclick = ()=> attemptPull(tier);
      tierGrid.appendChild(card);
    });

    // history (everything, most recent first, capped)
    const historyList = document.getElementById('historyList');
    historyList.innerHTML = '';
    const recent = state.log.slice(0,12);
    if(recent.length===0){
      historyList.innerHTML = '<div class="history-empty">No activity yet — log your first pomodoro above.</div>';
    } else {
      recent.forEach(entry=>{
        const row = document.createElement('div');
        row.className = 'history-row';
        const sign = entry.points >= 0 ? '+' : '';
        const statusClass = 'status-'+(entry.status||'approved');
        const thumb = entry.photo ? `<img class="history-thumb" src="${entry.photo}" alt="">` : '';
        row.innerHTML = `${thumb}<div class="history-main">${entry.label}<br><span class="who">${timeAgo(entry.ts)}${entry.status && entry.status!=='approved' ? ' · '+entry.status : ''}</span></div><span class="history-amt ${statusClass}">${sign}${entry.points}</span>`;
        historyList.appendChild(row);
      });
    }

    renderSettings();
  }

  function renderSettings(){
    const body = document.getElementById('settingsBody');
    body.innerHTML = '';

    const pvWrap = document.createElement('div');
    const pvFields = [
      ['pomodoro','Pomodoro'], ['lab','Lab visit'], ['email','Email/task'], ['wakeup','Wake-up'],
      ['streakEvery','Pomodoros per bonus'], ['streakBonus','Streak bonus']
    ];
    pvFields.forEach(([key,label])=>{
      const row = document.createElement('div');
      row.className = 'field-row';
      row.innerHTML = `<label>${label}</label>`;
      const input = document.createElement('input');
      input.type = 'number';
      input.min = '0';
      input.value = state.pointValues[key];
      input.onchange = (e)=>{
        const v = parseInt(e.target.value,10);
        state.pointValues[key] = isNaN(v) ? state.pointValues[key] : v;
        saveState(); render();
      };
      row.appendChild(input);
      pvWrap.appendChild(row);
    });
    body.appendChild(pvWrap);

    state.tiers.forEach((tier)=>{
      const box = document.createElement('div');
      box.className = 'tier-edit';
      const title = document.createElement('div');
      title.className = 'tier-edit-title';
      title.textContent = tier.name;
      box.appendChild(title);

      const costRow = document.createElement('div');
      costRow.className = 'field-row';
      costRow.innerHTML = `<label>Cost (tokens)</label>`;
      const costInput = document.createElement('input');
      costInput.type = 'number';
      costInput.min = '1';
      costInput.value = tier.cost;
      costInput.onchange = (e)=>{
        const v = parseInt(e.target.value,10);
        tier.cost = isNaN(v) ? tier.cost : v;
        saveState(); render();
      };
      costRow.appendChild(costInput);
      box.appendChild(costRow);

      tier.items.forEach((item, idx)=>{
        const row = document.createElement('div');
        row.className = 'item-edit-row';
        const input = document.createElement('input');
        input.value = item;
        input.onchange = (e)=>{
          tier.items[idx] = e.target.value;
          saveState();
        };
        const del = document.createElement('button');
        del.className = 'small-btn';
        del.textContent = 'remove';
        del.onclick = ()=>{
          if(tier.items.length<=1){ showToast('Keep at least one reward'); return; }
          tier.items.splice(idx,1);
          saveState(); render();
        };
        row.appendChild(input);
        row.appendChild(del);
        box.appendChild(row);
      });

      const addBtn = document.createElement('button');
      addBtn.className = 'small-btn';
      addBtn.textContent = '+ add reward';
      addBtn.onclick = ()=>{
        tier.items.push('New reward');
        saveState(); render();
      };
      box.appendChild(addBtn);

      body.appendChild(box);
    });

    const note = document.createElement('div');
    note.className = 'save-note';
    note.textContent = 'Changes save automatically and are shared between both of you.';
    body.appendChild(note);
  }

  document.getElementById('settingsToggle').onclick = ()=>{
    const body = document.getElementById('settingsBody');
    body.style.display = body.style.display === 'none' ? 'flex' : 'none';
  };

  document.getElementById('photoInput').addEventListener('change', (e)=>{
    const file = e.target.files[0];
    handlePhotoSelected(file);
    e.target.value = '';
  });

  if(initFirebase()){
    loadState();
  }
})();
</script>
