<style>
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap');

  :root{
    --bg:#14141f;
    --bg-alt:#1b1b29;
    --surface:#20202f;
    --surface-2:#262638;
    --line:#33334a;
    --text:#f1f0f6;
    --text-dim:#9a97ae;
    --pink:#ff4fa3;
    --cyan:#4fd8ff;
    --gold:#ffc857;
    --violet:#8b7cf6;
  }

  * { box-sizing:border-box; }

  #gacha-root{
    font-family:'Inter', system-ui, sans-serif;
    background:
      radial-gradient(60% 50% at 15% 0%, rgba(255,79,163,0.10), transparent 60%),
      radial-gradient(50% 45% at 100% 10%, rgba(79,216,255,0.10), transparent 60%),
      var(--bg);
    color:var(--text);
    min-height:100vh;
    min-height:100dvh;
    padding:calc(28px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(60px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left));
    line-height:1.45;
    -webkit-tap-highlight-color:transparent;
    overscroll-behavior-y:contain;
  }

  #gacha-root button{
    touch-action:manipulation;
    -webkit-tap-highlight-color:transparent;
  }
  #gacha-root input{
    -webkit-tap-highlight-color:transparent;
  }

  #gacha-root .wrap{ max-width:640px; margin:0 auto; }

  #gacha-root h1,#gacha-root h2,#gacha-root h3{
    font-family:'Space Grotesk', system-ui, sans-serif;
    margin:0;
  }

  /* ---- Hero ---- */
  .hero{ text-align:center; padding:8px 0 24px; }
  .hero .eyebrow{ font-size:13px; color:var(--text-dim); margin-bottom:6px; }
  .hero .points{
    font-size:64px; font-weight:700; letter-spacing:-0.02em;
    background:linear-gradient(90deg, var(--pink), var(--cyan));
    -webkit-background-clip:text; background-clip:text; color:transparent;
    line-height:1;
  }
  .hero .points-label{ font-size:14px; color:var(--text-dim); margin-top:6px; }
  .hero .streak{
    display:inline-flex; align-items:center; gap:6px; margin-top:14px; font-size:13px;
    color:var(--gold); background:rgba(255,200,87,0.1); border:1px solid rgba(255,200,87,0.25);
    padding:5px 12px; border-radius:999px;
  }

  /* ---- Section ---- */
  .section{
    background:var(--surface); border:1px solid var(--line); border-radius:16px;
    padding:20px; margin-bottom:16px;
  }
  .section h2{
    font-size:16px; font-weight:600; margin-bottom:14px;
    display:flex; align-items:center; justify-content:space-between;
  }
  .section h2 .badge{
    font-family:'Inter', sans-serif; font-weight:600; font-size:11px;
    color:var(--bg); background:var(--gold); padding:2px 8px; border-radius:999px;
  }

  /* ---- Log grid ---- */
  .log-grid{ display:grid; grid-template-columns:1fr 1fr; gap:10px; }
  .log-btn{
    background:var(--surface-2); border:1px solid var(--line); border-radius:12px;
    padding:14px 12px; color:var(--text); font-family:'Inter', sans-serif; font-size:14px;
    font-weight:500; text-align:left; cursor:pointer;
    transition:transform 0.12s ease, border-color 0.12s ease;
    display:flex; flex-direction:column; gap:4px;
    min-height:44px;
  }
  .log-btn:active{ transform:scale(0.97); border-color:var(--pink); }
  @media (hover:hover) and (pointer:fine){
    .log-btn:hover{ border-color:var(--pink); }
  }
  .log-btn .pts{ font-size:12px; color:var(--cyan); }
  .log-hint{ font-size:12px; color:var(--text-dim); margin-top:10px; }

  /* ---- Tiers ---- */
  .tier-grid{ display:grid; grid-template-columns:repeat(2,1fr); gap:10px; }
  .tier-card{
    border-radius:14px; padding:16px 14px; cursor:pointer; border:1px solid var(--line);
    background:var(--surface-2); position:relative; overflow:hidden;
    transition:transform 0.12s ease;
    min-height:44px;
  }
  .tier-card:active{ transform:scale(0.97); }
  @media (hover:hover) and (pointer:fine){
    .tier-card:hover{ transform:translateY(-2px); }
  }
  .tier-card.disabled{ opacity:0.4; cursor:not-allowed; transform:none; }
  .tier-card .glow{ position:absolute; inset:0; opacity:0.5; pointer-events:none; }
  .tier-card .name{ font-family:'Space Grotesk', sans-serif; font-weight:600; font-size:15px; position:relative; }
  .tier-card .cost{ font-size:12px; color:var(--text-dim); margin-top:4px; position:relative; }
  .tier-common .glow{ background:radial-gradient(circle at 30% 20%, rgba(79,216,255,0.35), transparent 70%); }
  .tier-rare .glow{ background:radial-gradient(circle at 30% 20%, rgba(139,124,246,0.4), transparent 70%); }
  .tier-epic .glow{ background:radial-gradient(circle at 30% 20%, rgba(255,79,163,0.4), transparent 70%); }
  .tier-legendary .glow{ background:radial-gradient(circle at 30% 20%, rgba(255,200,87,0.45), transparent 70%); }

  /* ---- Reveal ---- */
  .reveal-stage{ display:flex; justify-content:center; padding:18px 0 4px; }
  .reveal-card{ width:200px; height:120px; perspective:800px; }
  .reveal-inner{
    position:relative; width:100%; height:100%;
    transform-style:preserve-3d; -webkit-transform-style:preserve-3d;
    transition:transform 0.6s cubic-bezier(.2,.8,.2,1);
  }
  .reveal-inner.flipped{ transform:rotateY(180deg); }
  .reveal-face{
    position:absolute; inset:0; border-radius:14px;
    display:flex; align-items:center; justify-content:center; text-align:center;
    padding:14px;
    backface-visibility:hidden; -webkit-backface-visibility:hidden;
    border:1px solid var(--line);
  }
  .reveal-front{
    background:var(--bg-alt);
    font-size:13px; color:var(--text-dim);
    z-index:2;
  }
  .reveal-back{
    transform:rotateY(180deg);
    background:linear-gradient(135deg, #2a1a30, #14232f);
    flex-direction:column; gap:6px;
    z-index:1;
  }
  .reveal-back .tier-tag{ font-size:11px; color:var(--gold); font-weight:600; }
  .reveal-back .item-name{ font-family:'Space Grotesk', sans-serif; font-weight:600; font-size:16px; color:var(--text); }

  /* ---- Pending queue ---- */
  .pending-row{
    display:flex; gap:12px; align-items:center; padding:10px 0;
    border-bottom:1px solid var(--line);
  }
  .pending-row:last-child{ border-bottom:none; }
  .pending-thumb{
    width:52px; height:52px; border-radius:8px; object-fit:cover; flex-shrink:0;
    border:1px solid var(--line); background:var(--surface-2);
  }
  .pending-info{ flex:1; min-width:0; }
  .pending-info .label{ font-size:13px; font-weight:500; }
  .pending-info .meta{ font-size:11px; color:var(--text-dim); }
  .pending-actions{ display:flex; gap:6px; flex-shrink:0; }
  .approve-btn, .reject-btn{
    border-radius:8px; padding:9px 12px; font-size:13px; cursor:pointer; border:1px solid var(--line);
    min-height:40px; touch-action:manipulation; -webkit-tap-highlight-color:transparent;
  }
  .approve-btn{ background:rgba(79,216,255,0.15); color:var(--cyan); border-color:rgba(79,216,255,0.4); }
  .reject-btn{ background:rgba(255,79,163,0.1); color:var(--pink); border-color:rgba(255,79,163,0.3); }
  .pending-empty{ color:var(--text-dim); font-size:13px; text-align:center; padding:12px 0; }

  /* ---- History ---- */
  .history-list{ display:flex; flex-direction:column; gap:8px; }
  .history-row{
    display:flex; gap:10px; align-items:center; font-size:13px; padding:8px 0;
    border-bottom:1px solid var(--line);
  }
  .history-row:last-child{ border-bottom:none; }
  .history-thumb{
    width:34px; height:34px; border-radius:6px; object-fit:cover; flex-shrink:0;
    border:1px solid var(--line);
  }
  .history-main{ flex:1; min-width:0; }
  .history-row .who{ color:var(--text-dim); font-size:12px; }
  .history-amt{ font-weight:600; white-space:nowrap; }
  .status-approved{ color:var(--cyan); }
  .status-rejected{ color:var(--text-dim); text-decoration:line-through; }
  .status-pending{ color:var(--gold); }
  .history-empty{ color:var(--text-dim); font-size:13px; text-align:center; padding:12px 0; }

  /* ---- settings ---- */
  .settings-toggle{
    background:none; border:none; color:var(--text-dim); font-size:13px;
    cursor:pointer; text-decoration:underline; padding:0;
  }
  .settings-body{ margin-top:14px; display:flex; flex-direction:column; gap:14px; }
  .field-row{ display:flex; gap:8px; align-items:center; }
  .field-row label{ font-size:12px; color:var(--text-dim); width:140px; flex-shrink:0; }
  .field-row input{
    flex:1; background:var(--surface-2); border:1px solid var(--line); border-radius:8px;
    color:var(--text); padding:9px 10px; font-size:16px; font-family:'Inter', sans-serif;
  }
  .tier-edit{ border:1px solid var(--line); border-radius:10px; padding:10px; }
  .tier-edit-title{ font-size:13px; font-weight:600; margin-bottom:8px; }
  .item-edit-row{ display:flex; gap:6px; margin-bottom:6px; }
  .item-edit-row input{
    flex:1; font-size:16px; background:var(--surface-2); border:1px solid var(--line);
    border-radius:8px; color:var(--text); padding:9px 10px; font-family:'Inter', sans-serif;
  }
  .small-btn{
    background:var(--surface-2); border:1px solid var(--line); color:var(--text-dim);
    border-radius:8px; padding:5px 9px; font-size:12px; cursor:pointer;
  }
  .small-btn:hover{ color:var(--text); border-color:var(--pink); }
  .save-note{ font-size:12px; color:var(--text-dim); }

  .toast{
    position:fixed; bottom:20px; left:50%; transform:translateX(-50%);
    background:var(--surface-2); border:1px solid var(--pink);
    padding:10px 18px; border-radius:999px; font-size:13px;
    opacity:0; transition:opacity 0.25s ease; pointer-events:none; z-index:50;
  }
  .toast.show{ opacity:1; }

  @media (max-width:420px){
    .hero .points{ font-size:48px; }
    .log-grid{ grid-template-columns:1fr; }
    .tier-grid{ grid-template-columns:1fr 1fr; }
  }
</style>

<div id="gacha-root">
  <div class="wrap">
    <div class="hero">
      <div class="eyebrow">approved token count</div>
      <h1 class="points" id="pointsDisplay">0</h1>
      <div class="points-label">tokens available</div>
      <div class="streak" id="streakBadge" style="display:none;"></div>
    </div>

    <div class="section">
      <h2>Log a win</h2>
      <div class="log-grid" id="logGrid"></div>
      <div class="log-hint">Tap an action, then attach a photo — it's queued for review below until approved.</div>
      <input type="file" id="photoInput" accept="image/*" style="display:none;">
    </div>

    <div class="section">
      <h2>Needs review <span class="badge" id="pendingCount" style="display:none;"></span></h2>
      <div id="pendingList"></div>
    </div>

    <div class="section">
      <h2>Pull</h2>
      <div class="tier-grid" id="tierGrid"></div>
      <div class="reveal-stage" id="revealStage" style="display:none;">
        <div class="reveal-card">
          <div class="reveal-inner" id="revealInner">
            <div class="reveal-face reveal-front" id="revealFront">tap a banner to pull</div>
            <div class="reveal-face reveal-back">
              <div class="tier-tag" id="revealTierTag"></div>
              <div class="item-name" id="revealItemName"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="section">
      <h2>Recent activity</h2>
      <div class="history-list" id="historyList"></div>
    </div>

    <div class="section">
      <h2><span></span><button class="settings-toggle" id="settingsToggle">edit rewards &amp; point values</button></h2>
      <div class="settings-body" id="settingsBody" style="display:none;"></div>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

